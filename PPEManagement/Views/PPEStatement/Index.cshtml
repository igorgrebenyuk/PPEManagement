@{
ViewData["Title"] = "Ведомости выдачи СИЗ";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Ведомости выдачи СИЗ</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Создать ведомость
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div id="loading" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>

            <div id="statementsList" style="display: none;">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Организация</th>
                            <th>Подразделение</th>
                            <th>Основание</th>
                            <th>Дата</th>
                            <th>Действия</th>
                        </tr>
                        </thead>
                        <tbody id="statementsBody">
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="noData" class="text-center py-5 text-muted" style="display: none;">
                <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                <p class="mt-3">Ведомости не найдены</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function loadStatements() {
        try {
            const response = await fetch('/api/PpeStatement');
            const statements = await response.json();

            document.getElementById('loading').style.display = 'none';

            if (statements.length === 0) {
                document.getElementById('noData').style.display = 'block';
                return;
            }

            document.getElementById('statementsList').style.display = 'block';
            const tbody = document.getElementById('statementsBody');
            tbody.innerHTML = '';

            statements.forEach(statement => {
                const row = document.createElement('tr');
                row.innerHTML = `
                        <td>${statement.id}</td>
                        <td>${statement.organizationName}</td>
                        <td>${statement.departmentName || '-'}</td>
                        <td>${statement.reason}</td>
                        <td>${new Date(statement.issueDate).toLocaleDateString('ru-RU')}</td>
                        <td>
                            <a href="/PpeStatement/Details/${statement.id}" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Просмотр
                            </a>
                            <button onclick="deleteStatement('${statement.id}')" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Удалить
                            </button>
                        </td>
                    `;
                tbody.appendChild(row);
            });
        } catch (error) {
            document.getElementById('loading').style.display = 'none';
            alert('Ошибка загрузки: ' + error.message);
        }
    }

    async function deleteStatement(id) {
        if (!confirm('Вы уверены, что хотите удалить ведомость?')) return;

        try {
            const response = await fetch(`/api/PpeStatement/${id}`, {
                method: 'DELETE'
            });

            if (response.ok) {
                loadStatements();
            } else {
                alert('Ошибка при удалении');
            }
        } catch (error) {
            alert('Ошибка: ' + error.message);
        }
    }

    loadStatements();
</script>
}