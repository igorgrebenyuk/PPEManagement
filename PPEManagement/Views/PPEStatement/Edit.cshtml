@model PPEManagement.Services.Contracts.Models.PPEStatement.PPEStatementDetailModel

@{
    ViewData["Title"] = $"Редактирование ведомости";
}

<div class="container mt-4">
    <h2 class="mb-4">Редактирование ведомости</h2>

    <form id="editForm">
        <!-- Шапка -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Основная информация</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="organizationName" class="form-label">
                            Наименование организации <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="organizationName" 
                               value="@Model.OrganizationName" required>
                    </div>
                    <div class="col-md-6">
                        <label for="departmentName" class="form-label">
                            Подразделение/формирование НФГО
                        </label>
                        <input type="text" class="form-control" id="departmentName" 
                               value="@Model.DepartmentName">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="reason" class="form-label">
                            Основание выдачи <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="reason" required>
                            <option value="Плановая замена" selected="@(Model.Reason == "Плановая замена")">
                                Плановая замена
                            </option>
                            <option value="Тренировка" selected="@(Model.Reason == "Тренировка")">
                                Тренировка
                            </option>
                            <option value="Введение Плана ГО" selected="@(Model.Reason == "Введение Плана ГО")">
                                Введение Плана ГО
                            </option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="responsiblePerson" class="form-label">
                            Ответственное лицо
                        </label>
                        <input type="text" class="form-control" id="responsiblePerson" 
                               value="@Model.ResponsiblePerson">
                    </div>
                </div>
            </div>
        </div>

        <!-- Позиции -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Позиции ведомости</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th>№</th>
                                <th>ФИО сотрудника</th>
                                <th>Табельный номер</th>
                                <th>Наименование СИЗ</th>
                                <th>Номер партии</th>
                                <th>Размер</th>
                                <th>Количество</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            @{ int itemIndex = 0; }
                            @foreach (var item in Model.Items)
                            {
                                <tr data-index="@itemIndex">
                                    <td>@(itemIndex + 1)</td>
                                    <td><input type="text" class="form-control form-control-sm" value="@item.EmployeeFullName"></td>
                                    <td><input type="text" class="form-control form-control-sm" value="@item.PersonnelNumber"></td>
                                    <td><input type="text" class="form-control form-control-sm" value="@item.PPEName"></td>
                                    <td><input type="text" class="form-control form-control-sm" value="@item.BatchNumber"></td>
                                    <td><input type="text" class="form-control form-control-sm" value="@item.Size"></td>
                                    <td><input type="number" class="form-control form-control-sm" value="@item.Quantity" min="1"></td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm remove-item">Удалить</button>
                                    </td>
                                </tr>
                                itemIndex++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Кнопки -->
        <div class="d-flex justify-content-between">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Отмена</a>
            <button type="submit" class="btn btn-primary">Сохранить изменения</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let itemCounter = @Model.Items.Count;

        // Удаление позиции
        document.getElementById('itemsBody').addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-item')) {
                e.target.closest('tr').remove();
                renumberItems();
            }
        });

        // Перенумерация строк таблицы
        function renumberItems() {
            const rows = document.querySelectorAll('#itemsBody tr');
            rows.forEach((row, index) => {
                row.cells[0].textContent = index + 1;
            });
            itemCounter = rows.length;
        }

        // Отправка формы на бэкенд
        document.getElementById('editForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const items = [];
            document.querySelectorAll('#itemsBody tr').forEach((row) => {
                // Достаем значения строго по индексам ячеек таблицы (cells)
                const employeeFullNameInput = row.cells[1].querySelector('input');
                const personnelNumberInput = row.cells[2].querySelector('input');
                const ppeNameInput = row.cells[3].querySelector('input');
                const batchNumberInput = row.cells[4].querySelector('input');
                const sizeInput = row.cells[5].querySelector('input');
                const quantityInput = row.cells[6].querySelector('input');

                if (employeeFullNameInput && personnelNumberInput && ppeNameInput && batchNumberInput && sizeInput && quantityInput) {
                    items.push({
                        employeeFullName: employeeFullNameInput.value,
                        personnelNumber: personnelNumberInput.value,
                        ppeName: ppeNameInput.value,
                        batchNumber: batchNumberInput.value,
                        size: sizeInput.value,
                        quantity: parseInt(quantityInput.value) || 1,
                        issueDate: new Date().toISOString()
                    });
                }
            });

            const data = {
                id: '@Model.Id',
                organizationName: document.getElementById('organizationName').value,
                departmentName: document.getElementById('departmentName').value,
                reason: document.getElementById('reason').value,
                responsiblePerson: document.getElementById('responsiblePerson').value,
                issueDate: new Date().toISOString(),
                items: items
            };

            try {
                const response = await fetch(`/api/PpeStatement/${data.id}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    alert('Ведомость обновлена!');
                    window.location.href = `/PpeStatement/Details/${data.id}`;
                } else {
                    const error = await response.text();
                    alert('Ошибка: ' + error);
                }
            } catch (error) {
                alert('Ошибка: ' + error.message);
            }
        });
    </script>
}
